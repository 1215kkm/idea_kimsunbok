rules_version = '2';

// 다랜드 Firestore 보안 규칙
//
// 정책: 클라이언트는 어떤 컬렉션에도 직접 쓸 수 없다.
// 모든 쓰기는 서버 사이드 (Next.js API Routes의 firebase-admin)을 통해서만 가능.
// 읽기는 본인 데이터(users, transactions, withdrawals)와 공개 데이터(stores, advertisements,
// inviteCodes 메타정보)에 한해 허용한다.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /transactions/{txId} {
      allow read: if request.auth != null
        && resource.data.consumerId == request.auth.uid;
      allow write: if false;
    }

    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /advertisements/{adId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /inviteCodes/{code} {
      // 클라이언트 직접 read 차단. 코드 메타정보 조회는
      // 비인증 API Route(/api/invite/info)가 admin SDK로 처리.
      allow read: if false;
      allow write: if false;
    }

    match /inviteRedemptions/{inviteeUid} {
      allow read: if request.auth != null && request.auth.uid == inviteeUid;
      allow write: if false;
    }

    match /withdrawals/{reqId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /rewardCampaigns/{campaignId} {
      // 광고주 본인 캠페인만 읽기. 제출·승인·지급·환불은 전부 서버(admin SDK) 트랜잭션.
      allow read: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    match /rewardPayouts/{inviteeUid} {
      // 받은 사람(문서 ID = inviteeUid) 또는 지급한 광고주만 읽기.
      allow read: if request.auth != null
        && (request.auth.uid == inviteeUid
            || resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /rewardPayoutKeys/{emailHash} {
      // 이메일 정규화 해시 (1인 1회 보조 키). 클라이언트 전면 차단.
      allow read: if false;
      allow write: if false;
    }

    match /adminAuditLogs/{logId} {
      // 클라이언트 전면 차단. 관리자 API 로만 조회.
      allow read: if false;
      allow write: if false;
    }

    match /settings/{docId} {
      // 시스템 설정(분할모드 등): 관리자 API(/api/admin/settings)로만 접근
      allow read: if false;
      allow write: if false;
    }
  }
}
